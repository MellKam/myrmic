diff --git a/embedded/esp-hal/crates/wasm-runtime/src/probe.rs b/embedded/esp-hal/crates/wasm-runtime/src/probe.rs
new file mode 100644
index 0000000..268cfd9
--- /dev/null
+++ b/embedded/esp-hal/crates/wasm-runtime/src/probe.rs
@@ -0,0 +1,67 @@
+//! Timing experiment (aot-experiment): per-phase durations along the timer-tick path,
+//! summed in atomics and logged once every `EVERY` ticks so logging doesn't skew them.
+
+use embassy_time::Instant;
+use portable_atomic::{AtomicU32, Ordering};
+
+pub const WAIT: usize = 0; // WAMR thread blocked waiting for the next cell message
+pub const SRI1: usize = 1; // handle_timer_tick: GetSri
+pub const ARGS: usize = 2; // handler_args: StoreArguments + GetSri
+pub const OPEN: usize = 3; // call_in_transaction: GetSri + DbClient::Open
+pub const RUN: usize = 4; // run_export (the wasm call itself)
+pub const COMMIT: usize = 5; // DbClient::Commit
+pub const TICK: usize = 6; // whole tick, message received to handler done
+pub const HANDOFF: usize = 7; // every send_request_and_wait, as seen from the WAMR thread
+pub const DISPATCH: usize = 8; // ASYNC_REQUEST.signal -> executor starts executing it
+pub const EXEC: usize = 9; // executor: Request::execute
+pub const REPLY: usize = 10; // executor queued the response -> WAMR thread has it
+pub const PUMP: usize = 11; // cell_pump blocked in send_to_back
+pub const HOST: usize = 12; // wasm -> host import calls (sum over the tick)
+const N: usize = 13;
+const NAMES: [&str; N] = [
+    "wait", "getsri", "args", "open", "run", "commit", "tick", "handoff", "dispatch", "exec",
+    "reply", "pump", "host",
+];
+const EVERY: u32 = 50;
+
+static SUM: [AtomicU32; N] = [const { AtomicU32::new(0) }; N];
+static CNT: [AtomicU32; N] = [const { AtomicU32::new(0) }; N];
+static MAX: [AtomicU32; N] = [const { AtomicU32::new(0) }; N];
+static TICKS: AtomicU32 = AtomicU32::new(0);
+pub static DROPPED: AtomicU32 = AtomicU32::new(0);
+/// Timestamps handed between threads (low 32 bits of µs uptime).
+pub static SIGNALLED_AT: AtomicU32 = AtomicU32::new(0);
+pub static REPLIED_AT: AtomicU32 = AtomicU32::new(0);
+
+#[inline]
+pub fn now() -> u32 {
+    Instant::now().as_micros() as u32
+}
+
+#[inline]
+pub fn add(phase: usize, since: u32) {
+    let us = now().wrapping_sub(since);
+    SUM[phase].fetch_add(us, Ordering::Relaxed);
+    CNT[phase].fetch_add(1, Ordering::Relaxed);
+    MAX[phase].fetch_max(us, Ordering::Relaxed);
+}
+
+/// Called once per finished tick; every `EVERY` ticks logs avg/max/count per phase and resets.
+pub fn tick_done() {
+    if TICKS.fetch_add(1, Ordering::Relaxed) + 1 < EVERY {
+        return;
+    }
+    TICKS.store(0, Ordering::Relaxed);
+    let mut line = alloc::string::String::new();
+    for i in 0..N {
+        let c = CNT[i].swap(0, Ordering::Relaxed);
+        let s = SUM[i].swap(0, Ordering::Relaxed);
+        let m = MAX[i].swap(0, Ordering::Relaxed);
+        if c > 0 {
+            use core::fmt::Write;
+            let _ = write!(line, " {}={}/{}/{}", NAMES[i], s / c, m, c);
+        }
+    }
+    let dropped = DROPPED.swap(0, Ordering::Relaxed);
+    log::info!("PROBE {EVERY} ticks (avg/max us/count):{line} dropped={dropped}");
+}
